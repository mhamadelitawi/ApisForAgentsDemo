# API
SHOPCO_API_VERSION=v2
TOKEN_SUPPORT_AGENT=demo-agent-token
TOKEN_ADMIN=demo-admin-token
# Per-refund cap on the support-agent token. Above it, refunds need human approval.
# (15000 rather than 10000 so the scene 5 full refund of ord_8842 = 12900 goes through.)
SUPPORT_AGENT_MAX_REFUND_CENTS=15000

# Host ports (inside Docker the services always use 8000 / 8001 / 8002)
API_HOST_PORT=8800
MCP_HOST_PORT=8801
MCP_EVIL_HOST_PORT=8802

# MCP server: derive idempotency_key when the agent omits it. Keep off on stage.
IDEMPOTENCY_FALLBACK=false

# Scripted mode only: Claude
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=low

# Scripted mode only: Gemini (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
